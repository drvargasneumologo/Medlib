# ─── MedLib — Variables de Entorno ───────────────────────────────────────────
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas tu archivo .env a un repositorio público.

# ─── Identificación de aplicación (Recomendado) ───────────────────────────────
# PubMed, Europe PMC y Crossref solicitan un email de contacto como buena
# práctica. No se envía a ningún tercero, solo se usa en el User-Agent HTTP.
CONTACT_EMAIL=tu@email.com
USER_AGENT_APP_NAME=MedLib

# ─── NCBI / PubMed (Opcional) ─────────────────────────────────────────────────
# Sin API key: 3 requests/seg. Con API key: 10 requests/seg.
# Obtén una gratis en: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ─── Elsevier / Scopus (Opcional, requiere cuenta institucional) ──────────────
# Ver: https://dev.elsevier.com/
ELSEVIER_API_KEY=

# ─── Acceso Institucional (Módulo Experimental) ────────────────────────────────
# DESACTIVADO por defecto. Solo activar si se conocen los términos de acceso
# de tu institución y la automatización es legal bajo tu licencia.
INSTITUTION_ENABLED=false
INSTITUTION_NAME=
# ADVERTENCIA: No rellenes usuario/contraseña aquí si no entiendes los riesgos.
# Si activas el módulo, configúralo desde la página Settings de la interfaz.
INSTITUTION_USERNAME=
INSTITUTION_PASSWORD=

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=data/medlib.db

# ─── Parámetros de scoring (valores 0-20) ─────────────────────────────────────
SCORE_W_DOI=10
SCORE_W_ABSTRACT=12
SCORE_W_PMID=8
SCORE_W_BIOMEDICAL=10
SCORE_W_YEAR=8
SCORE_W_FULLTEXT=8
SCORE_W_EVIDENCE=10
SCORE_W_OA=5
