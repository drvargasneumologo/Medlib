# ─── MedLib v0.3.0 — Variables de Entorno ────────────────────────────────────
# Copia como .env y completa los valores. NUNCA subas .env a Git.

# ─── Identificación (OBLIGATORIO para PubMed/Crossref) ───────────────────────
CONTACT_EMAIL=tu@email.com
USER_AGENT_APP_NAME=MedLib

# ─── NCBI API Key (opcional, aumenta rate limit a 10 req/s) ──────────────────
# Obtener en: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ─── Elsevier / Scopus (requiere cuenta institucional) ───────────────────────
# Obtener en: https://dev.elsevier.com/
ELSEVIER_API_KEY=

# ─── Acceso Institucional a PDFs ─────────────────────────────────────────────
INSTITUTION_ENABLED=false
INSTITUTION_NAME=

# Método A: EZproxy (más común en universidades)
# Ejemplo UNAM: https://login.bidi.unam.mx/login?url=
# Ejemplo genérico: https://ezproxy.miinstitución.edu/login?url=
EZPROXY_BASE_URL=

# Método B: Proxy HTTP corporativo
# Ejemplo: http://proxy.institucion.edu.mx:3128
INSTITUTION_PROXY_HTTP=
INSTITUTION_PROXY_HTTPS=

# Método C: Cookie de sesión activa (ver instrucciones en Settings)
# Nombre de la cookie: sessionid, ShibSession, JSESSIONID, etc.
INSTITUTION_COOKIE_NAME=
# Valor de la cookie (se obtiene desde DevTools del navegador)
INSTITUTION_COOKIE_VALUE=

# ─── Google Scholar (módulo experimental) ────────────────────────────────────
# ADVERTENCIA: No tiene API oficial. Usar con moderación.
# Requiere: pip install scholarly
SCHOLAR_ENABLED=false
SCHOLAR_MAX_RESULTS=10
SCHOLAR_DELAY_SECONDS=3

# ─── Unpaywall (PDFs en acceso abierto) ──────────────────────────────────────
# Gratuito. Solo requiere el email de contacto configurado arriba.
UNPAYWALL_ENABLED=true
UNPAYWALL_AUTO_ENRICH=true

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=data/medlib.db

# ─── Parámetros de scoring (0-20 pts por criterio) ───────────────────────────
SCORE_W_DOI=10
SCORE_W_ABSTRACT=12
SCORE_W_PMID=8
SCORE_W_BIOMEDICAL=10
SCORE_W_YEAR=8
SCORE_W_FULLTEXT=8
SCORE_W_EVIDENCE=10
SCORE_W_OA=5
